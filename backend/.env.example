# Copy this file to ".env" (same folder) and fill in the values.
# The .env file is secret: it is listed in .gitignore so it never goes to GitHub.

# Neon connection string (starts with postgresql://)
DATABASE_URL=

# Gemini key from Google AI Studio (starts with AQ. or AIza)
GEMINI_API_KEY=

# A password you make up, used for admin actions like re-clustering
ADMIN_TOKEN=

# Optional settings (the defaults are fine)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-flash-lite-latest
# CITY_AUTHORITY=The Commissioner, Municipal Corporation
# HOTSPOT_RADIUS_M=20
# CONF_THRESHOLD=0.30
# FRONTEND_ORIGINS=http://localhost:5173
